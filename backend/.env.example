PORT=8080
DATABASE_URL=postgres://fuel_planner:fuel_planner_dev@localhost:5432/fuel_planner?sslmode=disable
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# mock (offline demo) or mapbox
MAP_PROVIDER=mock
# Mapbox token when MAP_PROVIDER=mapbox — use a SECRET token (sk.…) here (server-only).
# Directions, Geocoding, and Search Box (fuel POIs) run on the API; never put sk. in the web app.
MAP_API_KEY=
# Geocoding country bias (ISO 3166 alpha-2)
MAP_COUNTRY=ci
# Fuel POI search (Mapbox) — optional overrides
# MAP_STATIONS_MAX_DETOUR_KM=30
# MAP_STATIONS_ALONG_LIMIT=25
# MAP_STATIONS_NEARBY_RADIUS_KM=30
# MAP_STATIONS_NEARBY_LIMIT=40
# MAP_STATIONS_SAMPLE_LIMIT=25
